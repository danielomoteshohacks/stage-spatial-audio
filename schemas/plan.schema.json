{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/danielomoteshohacks/stage-spatial-audio/schemas/plan.schema.json",
  "title": "Stage mix plan",
  "description": "The contract between song analysis, the listener's settings and the renderer (decision 0017). Written as plan.json; the web app may edit it and send it back to /rerender. Azimuths are degrees counter-clockwise from the front (positive to the LEFT, the SOFA convention), elevation up, distances in metres.",
  "type": "object",
  "required": [
    "track_id",
    "engine",
    "mode",
    "intensity",
    "stems"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "track_id": {
      "type": "string",
      "minLength": 1
    },
    "engine": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "stems",
        "lite"
      ]
    },
    "intensity": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Equal to motion_depth; kept for older readers."
    },
    "genre": {
      "type": "string"
    },
    "genre_source": {
      "enum": [
        "default",
        "tagger",
        "user"
      ]
    },
    "style": {
      "type": "object",
      "description": "Soft style probabilities from the tagger.",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "template": {
      "type": "string"
    },
    "space": {
      "type": "string"
    },
    "motion_depth": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "crossover_hz": {
      "type": "number",
      "minimum": 40,
      "maximum": 300
    },
    "tempo_bpm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "first_downbeat_s": {
      "type": "number",
      "minimum": 0
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "start_s",
          "end_s",
          "label",
          "openness"
        ],
        "properties": {
          "start_s": {
            "type": "number",
            "minimum": 0
          },
          "end_s": {
            "type": "number",
            "minimum": 0
          },
          "label": {
            "enum": [
              "intro",
              "verse",
              "pre-chorus",
              "chorus",
              "drop",
              "bridge",
              "outro"
            ]
          },
          "openness": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "bed": {
      "type": "object",
      "properties": {
        "ambience": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "heights": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        }
      },
      "additionalProperties": false
    },
    "stems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "az",
          "el",
          "dist",
          "spread",
          "room_send",
          "orig_blend"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "pattern": "^(vocals|drums|bass|other|mix)\\.(direct|ambient|mid|high|all)$"
          },
          "az": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "el": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "dist": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 50
          },
          "spread": {
            "type": "number",
            "minimum": 0,
            "maximum": 360
          },
          "room_send": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "orig_blend": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "mono_below_hz": {
            "type": "number",
            "minimum": 0
          },
          "protected": {
            "type": "boolean"
          },
          "wide": {
            "type": "object",
            "required": [
              "spread",
              "el"
            ],
            "properties": {
              "spread": {
                "type": "number",
                "minimum": 0,
                "maximum": 360
              },
              "el": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              }
            },
            "additionalProperties": false
          },
          "motion": {
            "type": "object",
            "required": [
              "path",
              "period_bars",
              "depth"
            ],
            "properties": {
              "path": {
                "enum": [
                  "orbit",
                  "sway"
                ]
              },
              "period_bars": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "depth": {
                "type": "number",
                "minimum": 0,
                "maximum": 360
              },
              "max_deg_per_s": {
                "type": "number",
                "minimum": 0,
                "maximum": 45
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "room": {
      "type": "object",
      "properties": {
        "rt60_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "predelay_ms": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "protected": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "character": {
      "enum": [
        "intimate",
        "balanced",
        "immersive"
      ]
    }
  },
  "additionalProperties": false
}
