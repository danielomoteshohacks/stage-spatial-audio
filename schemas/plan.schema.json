{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/danielomoteshohacks/stage-spatial-audio/schemas/plan.schema.json",
  "title": "Stage mix plan",
  "description": "The contract between the mix-intelligence subsystem and the renderer.",
  "type": "object",
  "required": ["track_id", "engine", "mode", "intensity", "stems"],
  "properties": {
    "track_id": { "type": "string", "minLength": 1 },
    "engine": { "type": "string" },
    "style": {
      "type": "object",
      "description": "Soft style probabilities that sum to about 1.",
      "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
    },
    "mode": { "type": "string" },
    "intensity": { "type": "number", "minimum": 0, "maximum": 1 },
    "stems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "az", "el", "dist", "spread", "room_send", "orig_blend"],
        "properties": {
          "name": { "type": "string" },
          "az": { "type": "number", "minimum": -180, "maximum": 180 },
          "el": { "type": "number", "minimum": -90, "maximum": 90 },
          "dist": { "type": "number", "exclusiveMinimum": 0 },
          "spread": { "type": "number", "minimum": 0, "maximum": 1 },
          "room_send": { "type": "number", "minimum": 0, "maximum": 1 },
          "orig_blend": { "type": "number", "minimum": 0, "maximum": 1 },
          "mono_below_hz": { "type": "number", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "room": {
      "type": "object",
      "properties": {
        "rt60_s": { "type": "number", "exclusiveMinimum": 0 },
        "predelay_ms": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "protected": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
