{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/danielomoteshohacks/stage-spatial-audio/schemas/plan3.schema.json",
  "title": "Stage object plan (v3)",
  "description": "The v3 contract between analysis, the listener's settings and the object renderer (decisions 0024 and 0025). Every separated leaf is an object with a position, a distance and optional event paths; the record's own reverb is returned as `return` objects around and above the listener. Azimuths are degrees counter-clockwise from the front (positive to the LEFT, SOFA), elevation up, distances in metres. Written as plan.json; the web app may edit it and send it back to /rerender.",
  "type": "object",
  "required": [
    "version",
    "engine",
    "track_id",
    "mode",
    "space",
    "stems",
    "sections"
  ],
  "properties": {
    "version": {
      "const": 3
    },
    "engine": {
      "const": "soundstage-v3"
    },
    "track_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "const": "objects"
    },
    "genre": {
      "type": "string"
    },
    "space": {
      "type": "string"
    },
    "hrtf": {
      "type": "string"
    },
    "character": {
      "enum": [
        "intimate",
        "balanced",
        "immersive"
      ]
    },
    "motion_depth": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "crossover_hz": {
      "type": "number",
      "minimum": 40,
      "maximum": 300
    },
    "tempo_bpm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "start_s",
          "end_s",
          "openness"
        ],
        "properties": {
          "start_s": {
            "type": "number",
            "minimum": 0
          },
          "end_s": {
            "type": "number",
            "minimum": 0
          },
          "label": {
            "type": "string"
          },
          "openness": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "stems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/object"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "protected": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "keys": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "number"
        }
      }
    },
    "event": {
      "type": "object",
      "required": [
        "type",
        "t0",
        "t1",
        "az",
        "el"
      ],
      "properties": {
        "type": {
          "enum": [
            "riser",
            "lift",
            "fill",
            "throw"
          ]
        },
        "t0": {
          "type": "number"
        },
        "t1": {
          "type": "number"
        },
        "az": {
          "$ref": "#/$defs/keys"
        },
        "el": {
          "$ref": "#/$defs/keys"
        }
      }
    },
    "object": {
      "type": "object",
      "required": [
        "name",
        "leaf",
        "kind",
        "role",
        "mode",
        "az",
        "el",
        "dist",
        "feeds"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "leaf": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "object",
            "return"
          ]
        },
        "role": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "mono",
            "pair",
            "upmix",
            "side",
            "ring"
          ]
        },
        "az": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "el": {
          "type": "number",
          "minimum": -10,
          "maximum": 90
        },
        "dist": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 20
        },
        "gain_db": {
          "type": "number"
        },
        "protected": {
          "type": "boolean"
        },
        "breathes": {
          "type": "boolean"
        },
        "feeds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "ch",
              "az",
              "el"
            ],
            "properties": {
              "ch": {
                "enum": [
                  "L",
                  "R",
                  "M",
                  "C",
                  "Ls",
                  "Rs"
                ]
              },
              "az": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              "el": {
                "type": "number",
                "minimum": -10,
                "maximum": 90
              }
            }
          }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "az",
              "el"
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "protected": {
                "const": true
              }
            },
            "required": [
              "protected"
            ]
          },
          "then": {
            "properties": {
              "events": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  }
}
